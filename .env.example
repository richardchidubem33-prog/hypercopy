# ---------------------------------------------------------------------------
# HyperCopy environment variables
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Copy engine mode -------------------------------------------------------
# paper = simulate fills, no keys needed (default, safe)
# live  = place real orders on Hyperliquid
COPY_MODE=paper

# --- Live trading credentials (REQUIRED only when COPY_MODE=live) -----------
# Your Hyperliquid API wallet private key (0x-prefixed hex).
# Use an API wallet, NOT your main wallet. Fund it with only what you can lose.
HL_PRIVATE_KEY=

# Optional: main account address if using an API/agent wallet
HL_ACCOUNT_ADDRESS=

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Feed bot ---------------------------------------------------------------
# Seconds between position polls
FEED_POLL_SECONDS=15
